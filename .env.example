# Local OpenAI-compatible model endpoint. Copy to .env.local for local use.
# Keep real tokens in .env.local or your shell only; .env.local is git-ignored.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
WRITER_MODEL=Qwen/Qwen3-14B
CRITIC_MODEL=ibm-granite/granite-3.3-8b-instruct

# Optional for endpoints that require authentication. Plain local vLLM usually does not.
# LOCAL_LLM_API_KEY=

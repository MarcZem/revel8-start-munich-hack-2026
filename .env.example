# Local OpenAI-compatible model endpoint (AMD Token Factory or local vLLM).
# Copy to .env.local for local use. Keep real tokens in .env.local only; it is git-ignored.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
WRITER_MODEL=Qwen/Qwen3-14B
CRITIC_MODEL=ibm-granite/granite-3.3-8b-instruct

# Optional for endpoints that require authentication (Token Factory needs it; local vLLM usually does not).
# LOCAL_LLM_API_KEY=

# Official Revel8 practice API: fill in your own team key. Never commit .env.local.
TARGET_API_KEY=
